{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AXIOM",
  "version": "0.2.0",
  "identifier": "dev.numendev.axiom",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AXIOM — Mathematical Research Environment",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 540
      }
    ],
    "security": {
      "capabilities": ["workspace"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
